# Public Supabase project connection details.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only third-party credentials.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=

# Public application configuration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RAFFLE_EMAIL_FROM=

# Generate a long random value before launch. Do not change it after launch,
# because it derives permanent receipt URLs.
RECEIPT_TOKEN_SECRET=

# Generate a long random value before launch. It derives every verification
# link from the stored token id, so rotating it invalidates all links that have
# been sent and not yet used.
VERIFICATION_TOKEN_SECRET=

# Bearer credential for the email-outbox retry worker, which GitHub Actions
# calls on a */5 schedule it does not actually get — see that file. Generate a long
# random value and set the same one as a repository secret; without it the
# endpoint refuses every request.
CRON_SECRET=

# "send" (default) delivers through Resend. "log" renders the real template and
# records a successful delivery without contacting a provider — use it for
# staging and load tests. Production refuses "log" at startup. Surrounding
# whitespace is trimmed, so a value pasted with a trailing newline still works.
MAIL_DELIVERY_MODE=send

# Public-write allowances per 24 hours, both optional.
# RAFFLE_IP_REQUEST_LIMIT defaults to 500 and is the venue-network lever: at a
# festival hundreds of visitors share a handful of NAT addresses, so it is
# raised for the event (see docs/operations/prelaunch-checklist.md).
# RAFFLE_EMAIL_REQUEST_LIMIT defaults to 5 and is what stops one address being
# mail-bombed through the form. Leave it alone.
RAFFLE_IP_REQUEST_LIMIT=
RAFFLE_EMAIL_REQUEST_LIMIT=

# Optional. An incoming-webhook URL for Slack, Discord or Google Chat. Every
# unhandled server-side error is written to the log either way; this is what
# makes somebody find out during the event, when nobody is watching a log
# stream. Messages are redacted (no addresses, no tokens) and throttled to one
# per fault per five minutes. Leave it unset and only the log line happens.
# See docs/operations/monitoring.md.
ALERT_WEBHOOK_URL=

# Optional. How many queued messages /api/health calls "behind", default 50.
# The gauge is briefly non-zero in normal traffic; this is the depth at which it
# stops being normal. A value that will not parse falls back to the default,
# because unlike the request limits above, getting this wrong only mislabels a
# status word.
OUTBOX_BACKLOG_THRESHOLD=

# Test-only. Points e2e/production-smoke.spec.ts at a deployed origin, which
# also stops Playwright starting a local server. SMOKE_EVENT_SLUG overrides the
# slug it looks for and defaults to jfca-2026.
# SMOKE_BASE_URL=
# SMOKE_EVENT_SLUG=
